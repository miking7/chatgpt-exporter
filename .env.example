# Copy to .env (git-ignored) and adjust. `chatgpt-exporter login` adds the token for you.

# Where the archive lives (quotes needed if the path has spaces).
CHATGPT_EXPORT_DIR="/path/to/chatgpt-export"

# Written by `login`; don't commit these.
# CHATGPT_TOKEN=
# CHATGPT_ACCOUNT_ID=

# Pacing (defaults shown). 90 s keeps the backup at ~2/3 of ChatGPT's ~1/minute refill.
# CHATGPT_PACE_SECONDS=90
# CHATGPT_BURST=30
