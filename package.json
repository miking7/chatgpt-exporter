{
  "name": "chatgpt-exporter",
  "version": "2.0.0-fork.7",
  "private": true,
  "description": "CLI tool to export ChatGPT conversations (fork: saved login, incremental by default, paced under ChatGPT's limits)",
  "license": "MIT",
  "author": "Rodrigo Fernández",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "chatgpt-exporter": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "node --import tsx --test --test-timeout=60000 test/*.test.ts",
    "login": "node dist/index.js login",
    "backup": "node dist/index.js backup",
    "status": "node dist/index.js status"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/miking7/chatgpt-exporter.git"
  },
  "keywords": [
    "chatgpt",
    "backup",
    "export",
    "cli",
    "markdown"
  ],
  "dependencies": {
    "chalk": "^5.3.0",
    "cli-progress": "^3.12.0",
    "commander": "^14.0.3",
    "ora": "^9.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.5",
    "@types/node": "^25.3.0",
    "tsup": "^8.1.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5"
  }
}
